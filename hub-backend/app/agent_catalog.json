      "goalMode": "native",
      "group": "more",
      "order": 90,
      "summary": "Kimi 官方编码助手，通过 ACP 使用企业模型和插件工具。",
      "runner": {
        "adapter": "acp",
        "bins": [
          "kimi",
          "kimi.cmd",
          "kimi.exe"
        ],
        "args": [
          "acp"
        ],
        "home": {
          "env": "KIMI_CODE_HOME",
          "folder": ".kimi-code"
        },
        "modelEnv": {
          "KIMI_MODEL_BASE_URL": "base",
          "KIMI_MODEL_API_KEY": "key",
          "KIMI_MODEL_NAME": "model"
        },
        "launch": "node"
      },
      "install": {
        "installer": "npm",
        "pkg": "@moonshot-ai/kimi-code",
        "source": "https://github.com/MoonshotAI/kimi-code",
