        "adapter": "acp",
        "bins": [
          "codex-acp",
          "codex-acp.cmd",
          "codex-acp.exe"
        ],
        "args": [],
        "home": {
          "env": "CODEX_HOME",
          "folder": ".codex-harness"
        }
      },
      "install": {
        "installer": "npm",
        "pkg": "@agentclientprotocol/codex-acp",
